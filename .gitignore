# Foundry
cache/
out/
# Deploy receipts. Foundry rewrites these on every run and nothing in the repo reads them; a
# receipt from a --fork run is indistinguishable from a real one (it records the forked chain id),
# so a committed one is a claim that cannot be checked.
broadcast/
# `forge doc` output, but keep hand-written docs (GAS-REPORT, LIVE-INTEGRATION, ...)
docs/*
!docs/*.md

# Env / secrets
.env
.env.*
!.env.example

# OS
.DS_Store

# Gas snapshots produced by `forge snapshot` / vm.startSnapshotGas (noisy; regenerate locally)
snapshots/
.gas-snapshot

# Rust build artifacts for the analyzer wrapper tool
tools/**/target/
