# Copy to .env and fill in PRIVATE_KEY, then `source .env`.
# .env is gitignored — never commit your real key.
#
#   cp .env.example .env
#   # edit .env: paste your funded Sepolia key
#   source .env

# ── Sepolia deployer (FILL THIS IN) ─────────────────────────────────
export PRIVATE_KEY=0xYOUR_FUNDED_SEPOLIA_PRIVATE_KEY
export SEPOLIA_RPC_URL=https://ethereum-sepolia.publicnode.com

# ── Live Gas Killer AVS on Sepolia (the currently-served deployment) ─
# Read off the active target 0xdA8Ca87C…; 14 verifyAndUpdate rounds have run through this checker.
export AVS_ADDRESS=0xdCec8ce0a03848B55989Bcc711e424Ca31d9eeD9
export SIG_CHECKER_ADDRESS=0x4B0fc77f2A40312f5760a039656FDB683ac1415f

# ── Hosted aggregator (for script/live/gk-trigger.sh) ───────────────
# Bearer token for the testnet aggregator — ask the Gas Killer team; never commit the real value.
export INGRESS_PASSWORD=ASK_THE_GAS_KILLER_TEAM
export GK_RPC=https://ethereum-sepolia.publicnode.com
export GK_FROM=0xff467a85932cF543Df50255f00A8A829c12a3A11
