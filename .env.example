# Copy to .env and fill in PRIVATE_KEY, then `source .env`.
# .env is gitignored — never commit your real key.
#
#   cp .env.example .env
#   # edit .env: paste your funded Sepolia key
#   source .env

# ── Sepolia deployer (FILL THIS IN) ─────────────────────────────────
export PRIVATE_KEY=0xYOUR_FUNDED_SEPOLIA_PRIVATE_KEY
export SEPOLIA_RPC_URL=https://ethereum-sepolia.publicnode.com

# ── Live Gas Killer AVS on Sepolia ──────────────────────────────────
# Each redeployment of the testnet stack provisions its own BLSSignatureChecker. A consumer wired to
# a superseded one passes every off-chain check, is handed a signed payload, then reverts
# InvalidQuorumApkHash (0xe1310aed) on settlement. Current values:
#
#   https://gaskiller.xyz/docs/solidity/configuration
#
export AVS_ADDRESS=0xdCec8ce0a03848B55989Bcc711e424Ca31d9eeD9
export SIG_CHECKER_ADDRESS=0x4B0fc77f2A40312f5760a039656FDB683ac1415f
