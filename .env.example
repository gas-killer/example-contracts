# Copy to .env and fill in PRIVATE_KEY, then `source .env`.
# .env is gitignored — never commit your real key.
#
#   cp .env.example .env
#   # edit .env: paste your funded Sepolia key
#   source .env

# ── Sepolia deployer (FILL THIS IN) ─────────────────────────────────
export PRIVATE_KEY=0xYOUR_FUNDED_SEPOLIA_PRIVATE_KEY
export SEPOLIA_RPC_URL=https://ethereum-sepolia.publicnode.com

# ── Live Gas Killer AVS on Sepolia ──────────────────────────────────
# The testnet pins its SchnorrStakeRegistry across redeployments. A consumer wired to any other
# registry passes every off-chain check, is handed a signed payload, then reverts
# InvalidQuorumSignature on settlement. Current values:
#
#   https://gaskiller.xyz/docs/solidity/configuration
#
export AVS_ADDRESS=0x0eF3c25243004C0F81Dc678c3411E619D61577ef
export SCHNORR_STAKE_REGISTRY_ADDRESS=0x8A86301675ac9617895117afFE9577f5154555F9
